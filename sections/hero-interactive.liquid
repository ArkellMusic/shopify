<section
  class="hero-interactive"
  id="hero-interactive"
  style="min-height: {{ section.settings.height }}vh;"
>
  <div class="hero-interactive__background">
    <canvas id="hero-canvas" class="hero-canvas"></canvas>
  </div>

  <div class="hero-interactive__content">
    <div class="hero-interactive__text">

      <h1 class="hero-title">
        {{ section.settings.title }}
      </h1>

      <p class="hero-subtitle">
        {{ section.settings.subtitle }}
      </p>

      <button
        class="btn btn--secondary"
        data-scroll-to="featured-products"
        type="button"
      >
        {{ section.settings.button_text }}
      </button>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Interactivo",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "AM"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Ropa y Música Electrónica. Tu estilo, tu sonido."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "Explorar Colección"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Altura",
      "min": 50,
      "max": 100,
      "step": 10,
      "unit": "vh",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Hero Interactivo"
    }
  ]
}
{% endschema %}
