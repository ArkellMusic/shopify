<section
  class="hero-interactive"
  id="hero-interactive"
  data-enter-url="/collections/all"
>

  <!-- Fondo de nubes -->
  <div class="hero-clouds" aria-hidden="true">
    <div class="cloud-layer cloud-layer--back"></div>
    <div class="cloud-layer cloud-layer--middle"></div>
    <div class="cloud-layer cloud-layer--front"></div>
  </div>

  <!-- Contenido -->
  <div class="hero-interactive__content">

    <!-- Logo -->
    <div
      class="hero-logo"
      id="hero-logo"
      role="img"
      aria-label="Logo AM"
      tabindex="0"
    >

      <img
        src="{{ 'Logo-am.PNG' | asset_url }}"
        alt="Logo AM"
        class="hero-logo__image"
        draggable="false"
      >

    </div>

    <!-- Texto -->
    <div class="hero-interactive__text">

      <h1 class="hero-title">
        {{ section.settings.title }}
      </h1>

      <p class="hero-subtitle">
        {{ section.settings.subtitle }}
      </p>

      <button
        class="hero-enter"
        id="hero-enter"
        type="button"
      >
        {{ section.settings.button_text }}
      </button>

    </div>

  </div>

  <div class="hero-scroll-hint">
    DESLIZA EL LOGO
  </div>

</section>

{% schema %}
{
  "name": "Hero AM",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "AM"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Ropa y Música Electrónica"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "ENTRAR"
    }
  ],
  "presets": [
    {
      "name": "Hero AM"
    }
  ]
}
{% endschema %}
