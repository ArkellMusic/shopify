<header class="site-header">
  <div class="site-header__content">

    <div class="site-header__logo">
      <a href="{{ routes.root_url }}" class="logo">
        {% if shop.brand.logo %}
          <img
            src="{{ shop.brand.logo | image_url: width: 100 }}"
            alt="{{ shop.name | escape }}"
            width="100"
            class="logo__image"
          >
        {% else %}
          <span class="logo__text">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <nav class="site-header__nav">
      {% if settings.main_menu %}
        <ul class="nav-list">
          {% for link in linklists[settings.main_menu].links %}
            <li class="nav-item">
              <a href="{{ link.url }}" class="nav-link">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

    <div class="site-header__actions">

      <button
        class="icon-btn icon-btn--search"
        aria-label="Buscar"
        type="button"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5a6.5 6.5 0 10-6.5 6.5c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zM9.5 14C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
        </svg>
      </button>

      <button
        class="icon-btn icon-btn--cart"
        aria-label="Carrito"
        id="cart-btn"
        type="button"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1.003 1.003 0 0020 4H5.21l-.94-2H1zm10 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 1.99-.9 1.99-2-.89-2-1.99-2z"/>
        </svg>

        <span class="cart-count" id="cart-count">0</span>
      </button>

    </div>
  </div>
</header>
