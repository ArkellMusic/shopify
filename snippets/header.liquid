<header class="site-header">
  <div class="site-header__content">

    <div class="site-header__logo">
      <a href="{{ routes.root_url }}" class="logo">
        <span class="logo__text">{{ shop.name }}</span>
      </a>
    </div>

    <nav class="site-header__nav">
      {% if settings.main_menu != blank %}
        <ul class="nav-list">
          {% for link in settings.main_menu.links %}
            <li class="nav-item">
              <a href="{{ link.url }}" class="nav-link">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

    <div class="site-header__actions">

      <a
        href="{{ routes.search_url }}"
        class="icon-btn icon-btn--search"
        aria-label="Buscar"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
        </svg>
      </a>

      <a
        href="{{ routes.cart_url }}"
        class="icon-btn icon-btn--cart"
        aria-label="Carrito"
        id="cart-btn"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1.003 1.003 0 0020 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.89-2-1.99-2z"/>
        </svg>

        {% if cart.item_count > 0 %}
          <span class="cart-count" id="cart-count">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>

    </div>

  </div>
</header>
